{
  "expo": {
    "name": "Kariakoo Hustle",
    "slug": "kariakoo-hustle",
    "version": "1.0.1",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "splash": {
      "image": "./assets/splash.png",
      "backgroundColor": "#0E7C5A",
      "resizeMode": "contain"
    },
    "assetBundlePatterns": [
      "**/*"
    ],
    "android": {
      "package": "com.kadioko.kariakoohustle",
      "versionCode": 3,
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#0E7C5A"
      }
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.kariakoohustle.app"
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      [
        "react-native-google-mobile-ads",
        {
          "androidAppId": "ca-app-pub-1484098434630929~6907155869",
          "delayAppMeasurementInit": true
        }
      ],
      "expo-status-bar"
    ],
    "extra": {
      "eas": {
        "projectId": "6a893276-61f9-4f8a-8e4b-2cb24a5e1df3"
      }
    },
    "owner": "kadioko"
  }
}
