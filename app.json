{
  "expo": {
    "name": "Kariakoo Hustle",
    "slug": "kariakoo-hustle",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "splash": {
      "image": "./assets/splash.png",
      "backgroundColor": "#0E7C5A",
      "resizeMode": "contain"
    },
    "assetBundlePatterns": ["**/*"],
    "android": {
      "package": "com.kariakoohustle.app",
      "versionCode": 1,
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#0E7C5A"
      }
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.kariakoohustle.app"
    },
    "web": {
      "favicon": "./assets/favicon.png"
    }
  }
}
